# API and database settings. Use a unique random SESSION_SECRET (at least 32 bytes).
PORT=3000
# For Supabase or another hosted PostgreSQL, set DATABASE_URL and leave DB_* unused.
# Supabase direct connection usually works with SSL enabled by default.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# DB_SSL=false
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pos_crm_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
